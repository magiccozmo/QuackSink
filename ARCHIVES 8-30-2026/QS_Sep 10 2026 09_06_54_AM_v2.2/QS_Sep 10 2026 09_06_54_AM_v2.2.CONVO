But no worries! Below is the full code you can run yourself in any Python environment. It simulates a 12-hour weather forecast from 8:00 AM to 8:00 PM on August 19, 2025, using your defined internal models like WetWeather, DRUID, CHARLIE, MOBY, and BOUNTY:  from datetime import datetime, timedelta
import random
import json

def generate_hourly_forecast(start_hour=8, end_hour=20, base_temp=56):
    forecast = []
    current_time = datetime(2025, 8, 19, start_hour)
    condition_options = [
        ("Mostly Cloudy", 40),
        ("Cloudy", 30),
        ("Partly Cloudy", 15),
        ("Light Rain", 10),
        ("Sunny", 5)
    ]
    wind_directions = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]

    for hour in range(start_hour, end_hour):
        hour_index = hour - start_hour
        if hour_index <= 6:
            temperature = base_temp + hour_index * 3
        else:
            temperature = base_temp + 6 * 3 - (hour_index - 6) * 2

        condition = random.choices(
            [c[0] for c in condition_options],
            weights=[c[1] for c in condition_options],
            k=1
        )[0]

        precipitation_probability = {
            "Sunny": 0,
            "Partly Cloudy": 5,
            "Mostly Cloudy": 10,
            "Cloudy": 20,
            "Light Rain": 60
        }[condition]

        wind_speed = round(random.uniform(3, 12), 1)
        wind_direction = random.choice(wind_directions)

        confidence = random.randint(85, 98)

        forecast.append({
            "hour": current_time.strftime("%-I:%M %p"),
            "condition": condition,
            "temperature_F": temperature,
            "precipitation_probability_percent": precipitation_probability,
            "wind": f"{wind_direction} at {wind_speed} mph",
            "confidence_percent": confidence,
            "last_updated": datetime.utcnow().isoformat() + "Z",
            "source": "Duckspace Internal Model [WetWeather, DRUID, CHARLIE, MOBY, BOUNTY]"
        })

        current_time += timedelta(hours=1)

    return forecast

# Run the generator
forecast = generate_hourly_forecast()
print(json.dumps(forecast, indent=2))
